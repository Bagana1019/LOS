{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "MINIO_ENDPOINT",
    "JWT_SECRET",
    "INTEGRATION_MODE",
    "DEFAULT_ORG_ID",
    "AML_LIST_REFRESH_MINUTES"
  ],
  "globalPassThroughEnv": [
    "TEST_DATABASE_URL",
    "DWH_DATABASE_URL",
    "ORIGINATION_DATABASE_URL",
    "KYC_DATABASE_URL",
    "SCORING_DATABASE_URL",
    "VALUATION_DATABASE_URL",
    "DMS_DATABASE_URL",
    "GATEWAY_DATABASE_URL",
    "NODE_ENV",
    "OUTBOX_RELAY",
    "STORAGE_DRIVER",
    "MINIO_*",
    "DATA_*",
    "INTERNAL_AUTH_SECRET",
    "SEED_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build",
        "db:generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false,
      "dependsOn": [
        "db:migrate"
      ]
    }
  }
}
