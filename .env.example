# LOS Radix — хөгжүүлэлтийн орчин. `cp .env.example .env`. Production-д БҮХ нууцыг өөрчил.

# ── Postgres (нэг instance, сервис бүр өөрийн schema: origination, kyc, scoring, valuation, dms, iam) ──
DATABASE_URL=postgresql://los:los@localhost:5432/los
# Сервис тутмын override (заавал биш): ORIGINATION_DATABASE_URL=… GATEWAY_DATABASE_URL=…
# Тест (`pnpm test`): нэр нь `test`-ээр төгссөн DB байх ёстой — тест schema-г устгаад шинээр үүсгэнэ!
TEST_DATABASE_URL=postgresql://los:los@localhost:5432/los_test
DWH_DATABASE_URL=postgresql://dwh:dwh@localhost:5433/dwh

# ── Redis (event bus + BullMQ) ──
REDIS_URL=redis://localhost:6379
# Outbox → Redis relay-г унтраах (unit/e2e тест): OUTBOX_RELAY=off
OUTBOX_POLL_MS=500

# ── MinIO (dms) ──
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_BUCKET=los-files
# minio | memory (тест)
STORAGE_DRIVER=minio
FILE_MAX_BYTES=20971520

# ── Портууд ──
WEB_PORT=3000
# Web → gateway хаяг (build үед суулгагдана). Gateway-н WEB_ORIGIN нь web-ийн origin-той таарах ёстой (CORS + cookie)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000/api
GATEWAY_PORT=4000
ORIGINATION_PORT=4001
KYC_PORT=4002
SCORING_PORT=4003
VALUATION_PORT=4004
DMS_PORT=4005
DWH_SYNC_PORT=4006

# ── Сервис хоорондын хаяг (gateway proxy, origination → бусад) ──
ORIGINATION_URL=http://localhost:4001
KYC_URL=http://localhost:4002
SCORING_URL=http://localhost:4003
VALUATION_URL=http://localhost:4004
DMS_URL=http://localhost:4005
# origination → gateway (унших-зөвхөн лавлах: Excel/CSV экспортын салбар, ЗЭЗ-ийн нэр). 2026-11-19 · 4-р үе шат, docs/DECISIONS.md
GATEWAY_URL=http://localhost:4000

# ── Аюулгүй байдал ──
# JWT гарын үсэг (≥32 тэмдэгт). Үүсгэх: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=28800
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Нэвтрэх endpoint-ын хязгаар: IP тутамд минутад хүсэлт
LOGIN_RATE_LIMIT=10
# Gateway ↔ сервис: тохируулсан бол gateway `X-Internal-Token` нэмж, сервис шалгана (gateway-г тойрч шууд дуудахаас хамгаална)
INTERNAL_AUTH_SECRET=dev-internal-secret-change-me
# Gateway лавлах `GET /api/internal/directory` (origination-ийн экспортын нэр): INTERNAL_AUTH_SECRET-ээс ТУСДАА нууц (proxy INTERNAL_AUTH_SECRET-ийг бүх backend-д тарааж өгдөг).
#   [gateway]     `X-Directory-Token`-г энэ утгатай safeEqual-аар шалгана; тохируулаагүй бол 503. Production-д ≥16 тэмдэгт, "change-me" загвар биш,
#                 INTERNAL_AUTH_SECRET-тэй ижил биш — эс бөгөөс gateway эхлэхгүй.
#   [origination] ижил утгыг `X-Directory-Token` болгож илгээнэ; тохируулаагүй бол экспорт id-тай (warning лог).
#   Ingress `/api/internal/*`-ийг нийтийн сүлжээнээс ХААХ ёстой. Үүсгэх: openssl rand -base64 32
GATEWAY_DIRECTORY_TOKEN=dev-directory-token-change-me
# CORS/cookie origin (таслалаар). Reverse proxy ард ажиллуулбал TRUST_PROXY=1
WEB_ORIGIN=http://localhost:3000
# TRUST_PROXY=1

# Хувийн мэдээлэл шифрлэх (AES-256-GCM, packages/database/src/crypto.ts). 32 byte base64: `openssl rand -base64 32`.
# ЭНЭ ТҮЛХҮҮРҮҮД ЗӨВХӨН ХӨГЖҮҮЛЭЛТИЙН — production-д өөрийн түлхүүр, KMS/secret manager ашигла.
DATA_ENCRYPTION_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
# Түлхүүр солих үед: DATA_ENCRYPTION_KEYS=k1:<b64>,k2:<b64> ба DATA_ENCRYPTION_KEY_ID=k2
# Blind index (шифрлэсэн талбараар хайх HMAC) түлхүүр
DATA_INDEX_KEY=CQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQk=

# ── Seed ──
# Seed хэрэглэгчдийн нууц үг (officer.a, officer.b, manager, approver, admin). Production-д анхдагчийг хориглоно.
SEED_PASSWORD=Los@2026!dev
DEFAULT_ORG_ID=

# ── Гадаад интеграци: mock | real (CLAUDE.md §3.2.7) ──
INTEGRATION_MODE=mock
# NODE_ENV=production үед INTEGRATION_MODE заавал тохируулна (kyc зохиомол UN/FATF жагсаалтаар чимээгүй ажиллахаас сэргийлнэ)

# Модуль тус бүрийг тусад нь солих: INTEGRATION_MODE_QPAY | _SOCIALPAY | _BANK_TRANSFER | _SMS | _EMAIL | _PUSH | _CORE_DEPOSIT (docs/05 §4)
# QPay (real): QPAY_USERNAME, QPAY_PASSWORD, QPAY_INVOICE_CODE, QPAY_CALLBACK_BASE_URL, QPAY_BASE_URL
#   production + real үед БҮГД заавал (bootstrap-д шалгана): QPAY_BASE_URL нь https, sandbox хост биш; QPAY_CALLBACK_BASE_URL нь https. Нууц утгыг энд бүү бич.
# SainScore (ЗМС / CIB лавлагаа, kyc; INTEGRATION_MODE=real): SAINSCORE_BASE_URL, SAINSCORE_USERNAME, SAINSCORE_PASSWORD_HASH (vendor-ийн convert-hash-map-ээр гаргасан hash — түүхий нууц үг БИШ), SAINSCORE_PRODUCT_NO
#   production + real үед БҮГД заавал (bootstrap-д шалгана), SAINSCORE_BASE_URL нь https. Нууц утгыг энд бүү бич.
#   Сонголттой (хүүгүй LN-ийн таамагласан хүү — BR, бизнесээр батлуулна; анхдагч нь жишээ): SAINSCORE_ASSUMED_MONTHLY_RATE_PCT (2.5), SAINSCORE_ASSUMED_MONTHLY_RATE_LARGE_PCT (1.6), SAINSCORE_LARGE_LOAN_THRESHOLD_MNT (50000000)
# Email (real): SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS, SMTP_FROM
# Мэдэгдлийн дараалал: NOTIFICATION_QUEUE=inline (REDIS_URL байхгүй бол автоматаар); төлбөрийн timer унтраах: PAYMENT_MAINTENANCE=off

# ── Compliance & AML (docs/05-compliance-aml.md) ──
# UN SC / FATF жагсаалтыг cache-ээс дахин татах хугацаа (минут)
AML_LIST_REFRESH_MINUTES=360

# ── scoring (BSA) / dms (OCR) — бүгд заавал биш; анхдагчийг apps/scoring/README.md, docs/05-bsa-ocr.md-ээс харна ──
# MinIO: scoring хуулгын эх файлыг шифрлэж `BSA_BUCKET`-д хадгална (MINIO_ENDPOINT+MINIO_PORT эсвэл host:port). Байхгүй бол in-memory (зөвхөн dev)
# BSA_BUCKET=bsa-statements
# BSA_MAX_UPLOAD_BYTES=20971520
# OCR: dms `/api/ocr/extract`, scoring нь OCR-ээр уншсан хуулгыг дотор нь ашиглана. tesseract/pdftoppm PATH-д байх ёстой
# OCR_ENGINE=tesseract
# TESSERACT_BIN=tesseract
# PDFTOPPM_BIN=pdftoppm

# ── Цахим гарын үсэг (FR-11.4; dms) — бүгд заавал биш, анхдагч утгатай. Production-д INTEGRATION_MODE=real + https URL заавал ──
# ESIGN_PUBLIC_BASE_URL=http://localhost:3000        # зээлдэгчийн линк …/sign/<token>, QR …/verify/<code>
# ESIGN_CALLBACK_BASE_URL=http://localhost:4000/api  # provider webhook (gateway-ийн public суурь)
# ESIGN_LINK_TTL_HOURS=72
# ESIGN_SESSION_TTL_SECONDS=300
# ESIGN_MAX_ATTEMPTS=3
# ESIGN_SIGNED_COPY_TTL_DAYS=30                       # гарын үсэгтэй хувийг линкээр татах хугацаа
# MOCK_ESIGN_APPROVE_AFTER_MS=3000
# TRIDUM_BASE_URL= / TRIDUM_CLIENT_ID= / TRIDUM_CLIENT_SECRET= / TRIDUM_WEBHOOK_SECRET=   (MONPASS_* ижил; зөвхөн real)
# Gateway public e-sign rate limit (IP тутамд минутад): ESIGN_RATE_LIMIT_PER_MIN=60, ESIGN_WEBHOOK_RATE_LIMIT_PER_MIN=600

# ── ERP синк (FIN-SYNC; apps/origination/src/modules/erp-sync/README.md) ──
# ERP нь журналын эзэн: LOS олголт / шимтгэл суутгал / эргэн төлөлтийн үйл явдлыг webhook-оор дамжуулна.
# INTEGRATION_MODE=real үед ERP_API_URL (https), ERP_WEBHOOK_SECRET (≥16 тэмдэгт) заавал.
# Production-д INTEGRATION_MODE-ыг тодорхой зааж өгөхгүй бол origination эхлэхгүй.
ERP_API_URL=
ERP_WEBHOOK_SECRET=
ERP_API_TOKEN=
# 2xx хариунд лавлах дугаар заавал шаардах (дугаар өгдөггүй системд л false)
ERP_REQUIRE_ACK=true
ERP_RELAY_ENABLED=true
ERP_RELAY_INTERVAL_MS=5000
ERP_MAX_ATTEMPTS=48

# ── Аудитын засвар (2026-11-18): gateway, олголт ──
# Express trust proxy: load balancer-ийн тоо (жнь 1). Тохируулаагүй бол X-Forwarded-For-д итгэхгүй (IP хуурамчаар тавихаас сэргийлнэ).
TRUST_PROXY=
# Нэвтрэлт: оролдлогыг (хэрэглэгч, IP)-ээр нууц үг шалгахаас ӨМНӨ атомараар тоолно (LOGIN_RATE_LIMIT / цонх; амжилттай нэвтрэлт цэвэрлэнэ),
# IP-ийн дээд хязгаар нь password spraying-аас хамгаална. Дансны түгжээ (LOGIN_MAX_FAILURES) мөн атомар нөөцлөлтэй.
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_IP_RATE_LIMIT=100
# Төлбөрийн провайдерын callback (gateway-ээр нээлттэй цорын ганц баталгаажаагүй маршрут; origination нэхэмжлэлийг провайдераас дахин шалгана).
# PAYMENT_CALLBACK_TRUSTED_CIDRS_<QPAY|SOCIALPAY>: провайдерын албан ёсны эх IP хүрээ (таслалаар, IPv4/IPv6 CIDR эсвэл хаяг; /0 хориотой).
#   Буруу утга → gateway эхлэхгүй. Production-д хоосон бол анхааруулга: тэр провайдерын жинхэнэ callback итгэмжлэгдээгүй хязгаараар явна.
#   IP-г TRUST_PROXY-г мөрдөж тодорхойлно (клиентийн X-Forwarded-For итгэмжлэл олгохгүй).
# Итгэмжлэгдсэн IP: PAYMENT_CALLBACK_RATE_LIMIT — провайдер ТУС БҮРИЙН нийт хувин (бүх gateway pod), минутад;
#   PAYMENT_CALLBACK_IP_RATE_LIMIT — нэг IP-ийн дээд хязгаар, минутад (хэтэрсэн IP хувинг зарцуулахгүй).
# Бусад IP (провайдерын хувинд хэзээ ч хүрэхгүй): PAYMENT_CALLBACK_UNTRUSTED_IP_RATE_LIMIT — нэг IP, минутад;
#   PAYMENT_CALLBACK_UNTRUSTED_RATE_LIMIT — провайдер тус бүрийн «итгэмжлэгдээгүй» нийт хувин, минутад.
PAYMENT_CALLBACK_TRUSTED_CIDRS_QPAY=
PAYMENT_CALLBACK_TRUSTED_CIDRS_SOCIALPAY=
PAYMENT_CALLBACK_RATE_LIMIT=1200
PAYMENT_CALLBACK_IP_RATE_LIMIT=600
PAYMENT_CALLBACK_UNTRUSTED_IP_RATE_LIMIT=30
PAYMENT_CALLBACK_UNTRUSTED_RATE_LIMIT=300
PAYMENT_CALLBACK_MAX_BODY_BYTES=16384
PAYMENT_CALLBACK_TIMEOUT_MS=20000
# Олголт: Core-д гацсан олголтыг шалгах sweeper (0 = унтраах); тодорхойгүй үр дүнгийн дараа "олдсонгүй"-г эцсийн гэж үзэх хүлээлт (120–86400).
DISBURSEMENT_RECONCILE_SWEEP_SECONDS=300
DISBURSEMENT_CORE_SETTLE_SECONDS=900
