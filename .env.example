# LOS Radix — хөгжүүлэлтийн орчин. `cp .env.example .env`. Production-д БҮХ нууцыг өөрчил.

# ── Postgres (нэг instance, сервис бүр өөрийн schema: origination, kyc, scoring, valuation, dms, iam) ──
DATABASE_URL=postgresql://los:los@localhost:5432/los
# Сервис тутмын override (заавал биш): ORIGINATION_DATABASE_URL=… GATEWAY_DATABASE_URL=…
# Тест (`pnpm test`): нэр нь `test`-ээр төгссөн DB байх ёстой — тест schema-г устгаад шинээр үүсгэнэ!
TEST_DATABASE_URL=postgresql://los:los@localhost:5432/los_test
DWH_DATABASE_URL=postgresql://dwh:dwh@localhost:5433/dwh

# ── Redis (event bus + BullMQ) ──
REDIS_URL=redis://localhost:6379
# Outbox → Redis relay-г унтраах (unit/e2e тест): OUTBOX_RELAY=off
OUTBOX_POLL_MS=500

# ── MinIO (dms) ──
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_BUCKET=los-files
# minio | memory (тест)
STORAGE_DRIVER=minio
FILE_MAX_BYTES=20971520

# ── Портууд ──
WEB_PORT=3000
GATEWAY_PORT=4000
ORIGINATION_PORT=4001
KYC_PORT=4002
SCORING_PORT=4003
VALUATION_PORT=4004
DMS_PORT=4005
DWH_SYNC_PORT=4006

# ── Сервис хоорондын хаяг (gateway proxy, origination → бусад) ──
ORIGINATION_URL=http://localhost:4001
KYC_URL=http://localhost:4002
SCORING_URL=http://localhost:4003
VALUATION_URL=http://localhost:4004
DMS_URL=http://localhost:4005

# ── Аюулгүй байдал ──
# JWT гарын үсэг (≥32 тэмдэгт). Үүсгэх: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=28800
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Нэвтрэх endpoint-ын хязгаар: IP тутамд минутад хүсэлт
LOGIN_RATE_LIMIT=10
# Gateway ↔ сервис: тохируулсан бол gateway `X-Internal-Token` нэмж, сервис шалгана (gateway-г тойрч шууд дуудахаас хамгаална)
INTERNAL_AUTH_SECRET=dev-internal-secret-change-me
# CORS/cookie origin (таслалаар). Reverse proxy ард ажиллуулбал TRUST_PROXY=1
WEB_ORIGIN=http://localhost:3000
# TRUST_PROXY=1

# Хувийн мэдээлэл шифрлэх (AES-256-GCM, packages/database/src/crypto.ts). 32 byte base64: `openssl rand -base64 32`.
# ЭНЭ ТҮЛХҮҮРҮҮД ЗӨВХӨН ХӨГЖҮҮЛЭЛТИЙН — production-д өөрийн түлхүүр, KMS/secret manager ашигла.
DATA_ENCRYPTION_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
# Түлхүүр солих үед: DATA_ENCRYPTION_KEYS=k1:<b64>,k2:<b64> ба DATA_ENCRYPTION_KEY_ID=k2
# Blind index (шифрлэсэн талбараар хайх HMAC) түлхүүр
DATA_INDEX_KEY=CQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQk=

# ── Seed ──
# Seed хэрэглэгчдийн нууц үг (officer.a, officer.b, manager, approver, admin). Production-д анхдагчийг хориглоно.
SEED_PASSWORD=Los@2026!dev
DEFAULT_ORG_ID=

# ── Гадаад интеграци: mock | real (CLAUDE.md §3.2.7) ──
INTEGRATION_MODE=mock

# ── Цахим гарын үсэг (FR-11.4; dms) — бүгд заавал биш, анхдагч утгатай. Production-д INTEGRATION_MODE=real + https URL заавал ──
# ESIGN_PUBLIC_BASE_URL=http://localhost:3000        # зээлдэгчийн линк …/sign/<token>, QR …/verify/<code>
# ESIGN_CALLBACK_BASE_URL=http://localhost:4000/api  # provider webhook (gateway-ийн public суурь)
# ESIGN_LINK_TTL_HOURS=72
# ESIGN_SESSION_TTL_SECONDS=300
# ESIGN_MAX_ATTEMPTS=3
# ESIGN_SIGNED_COPY_TTL_DAYS=30                       # гарын үсэгтэй хувийг линкээр татах хугацаа
# MOCK_ESIGN_APPROVE_AFTER_MS=3000
# TRIDUM_BASE_URL= / TRIDUM_CLIENT_ID= / TRIDUM_CLIENT_SECRET= / TRIDUM_WEBHOOK_SECRET=   (MONPASS_* ижил; зөвхөн real)
# Gateway public e-sign rate limit (IP тутамд минутад): ESIGN_RATE_LIMIT_PER_MIN=60, ESIGN_WEBHOOK_RATE_LIMIT_PER_MIN=600
