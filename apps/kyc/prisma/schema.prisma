// Schema-per-service: зөвхөн `kyc` schema. Өөр schema-ийн хүснэгт рүү FK хориотой — ID-г string-ээр хадгална.
// Эзэмшил: inquiry, unregistered_loan, kyc_check, aml_screening (CLAUDE.md §4). application_id/customer_id нь origination-ийн ID (string).
// Дүрэм: docs/03-data-model.md (мөнгө Decimal(18,2), харьцаа Decimal(7,4) бутархай, enum-шиг талбар String — утгыг @los/contracts шалгана).
generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client-kyc"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["kyc"]
}

model Outbox {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox")
  @@schema("kyc")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([consumer, eventId])
  @@map("processed_events")
  @@schema("kyc")
}

/// FR-3: ЗМС, FICO, ХУР гэх мэт лавлагаа. fetched_at/expires_at → хуучралтын анхааруулга (setting inquiry.stale_days).
/// raw_json нь гадаад системийн хариуг хэвээр агуулдаг (хувийн мэдээлэлтэй) — M3-д шифрлэх эсэхийг шийднэ (DECISIONS.md).
model Inquiry {
  id            String    @id @default(uuid())
  orgId         String    @map("org_id")
  applicationId String    @map("application_id")
  customerId    String    @map("customer_id")
  source        String // InquirySource
  fetchedAt     DateTime  @default(now()) @map("fetched_at")
  fetchedBy     String?   @map("fetched_by")
  expiresAt     DateTime? @map("expires_at")
  rawJson       Json?     @map("raw_json")
  summaryJson   Json?     @map("summary_json") // active_loan_count, total_disbursed, outstanding, monthly_payment, fico_score, dti…
  warningLevel  String?   @map("warning_level")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")

  @@index([applicationId, customerId, source, fetchedAt])
  @@index([customerId])
  @@map("inquiry")
  @@schema("kyc")
}

/// ЗМС-д бүртгэлгүй зээл (гараар).
model UnregisteredLoan {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  applicationId  String   @map("application_id")
  customerId     String   @map("customer_id")
  lenderName     String   @map("lender_name")
  amount         Decimal  @db.Decimal(18, 2)
  monthlyPayment Decimal  @map("monthly_payment") @db.Decimal(18, 2)
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")

  @@index([applicationId, customerId])
  @@map("unregistered_loan")
  @@schema("kyc")
}

/// KYC шалгалтын үр дүн (хар жагсаалт, PEP, хамааралтай этгээд, барьцааны өмчлөл). BR-9: result=WARNING нь хориг биш.
model KycCheck {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  applicationId String?  @map("application_id")
  customerId    String   @map("customer_id")
  checkType     String   @map("check_type") // BLACKLIST | PEP | RELATED_PARTY | OWNERSHIP
  result        String // CLEAR | WARNING | HIT
  detailsJson   Json?    @map("details_json")
  checkedAt     DateTime @default(now()) @map("checked_at")
  checkedBy     String?  @map("checked_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String?  @map("created_by")
  updatedBy     String?  @map("updated_by")

  @@index([customerId, checkType, checkedAt])
  @@index([applicationId])
  @@map("kyc_check")
  @@schema("kyc")
}

/// Мөнгө угаахын эсрэг (AML) шалгалт: хориглох жагсаалтын тулгалт, эрсдэлийн оноо (customer.aml_risk_score-ийн эх сурвалж).
model AmlScreening {
  id         String    @id @default(uuid())
  orgId      String    @map("org_id")
  customerId String    @map("customer_id")
  listName   String    @map("list_name")
  matchScore Decimal?  @map("match_score") @db.Decimal(5, 2) // 0–100
  riskScore  Int?      @map("risk_score")
  status     String    @default("CLEAR") // CLEAR | POTENTIAL_MATCH | CONFIRMED | DISMISSED
  rawJson    Json?     @map("raw_json")
  screenedAt DateTime  @default(now()) @map("screened_at")
  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")

  @@index([customerId, screenedAt])
  @@map("aml_screening")
  @@schema("kyc")
}

/// Compliance & AML (docs/05): нэг шалгалтын нэгтгэл (UN SC + FATF + дотоод хар жагсаалт) ба hit-үүд. docs/03-ийн `aml_screening` (жагсаалт тус бүрийн мөр) өөрчлөгдөөгүй.
model AmlCheck {
  id                  String   @id @default(uuid()) @db.Uuid
  orgId               String   @map("org_id")
  customerId          String   @map("customer_id")
  applicationId       String?  @map("application_id")
  trigger             String
  status              String
  blocking            Boolean
  riskScore           Decimal  @map("risk_score") @db.Decimal(5, 2)
  riskLevel           String   @map("risk_level")
  riskFactorsJson     Json     @map("risk_factors_json")
  subjectName         String   @map("subject_name")
  registerNoMasked    String   @map("register_no_masked")
  registerNoHash      String   @map("register_no_hash")
  registerNoEncrypted String   @map("register_no_encrypted")
  subjectJson         Json     @map("subject_json")
  listVersionsJson    Json     @map("list_versions_json")
  screenedAt          DateTime @map("screened_at")
  screenedBy          String?  @map("screened_by")
  correlationId       String   @map("correlation_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  hits                AmlHit[]

  @@index([orgId, customerId, screenedAt(sort: Desc)])
  @@index([orgId, registerNoHash])
  @@map("aml_check")
  @@schema("kyc")
}

model AmlHit {
  id            String       @id @default(uuid()) @db.Uuid
  screeningId   String       @map("screening_id") @db.Uuid
  screening     AmlCheck @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  position      Int
  list          String
  matchType     String       @map("match_type")
  score         Decimal      @db.Decimal(5, 4)
  severity      String
  status        String
  entryRef      String       @map("entry_ref")
  entryName     String       @map("entry_name")
  matchedValue  String?      @map("matched_value")
  detailsJson   Json         @map("details_json")
  listVersion   String       @map("list_version")
  reviewedBy    String?      @map("reviewed_by")
  reviewedAt    DateTime?    @map("reviewed_at")
  reviewComment String?      @map("review_comment")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([screeningId, position])
  @@index([status, list])
  @@map("aml_hit")
  @@schema("kyc")
}

// origination.blacklist-ийн read model (BlacklistEntryChanged event-ээр). id = origination blacklist id, FK-гүй (CLAUDE.md §3.2.3).
model BlacklistProjection {
  id             String   @id
  orgId          String   @map("org_id")
  registerNoHash String   @map("register_no_hash")
  customerType   String   @map("customer_type")
  name           String
  listType       String   @map("list_type")
  reasonCode     String   @map("reason_code")
  isActive       Boolean  @map("is_active")
  changedAt      DateTime @map("changed_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([orgId, registerNoHash])
  @@map("blacklist_projection")
  @@schema("kyc")
}
