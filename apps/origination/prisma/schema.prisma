/// FR-5.5 Эрсдэлд суурилсан үнэ: Sosco Score → хүү/шимтгэлийн шатлал. Хадгалах бүрд шинэ version, өмнөх нь is_active=false (түүх хадгална).
/// product_id = null → байгууллагын нийтлэг шатлал. Хүү, шимтгэл бутархай (0.2399 = 23.99%) — docs/03.
model PricingTier {
