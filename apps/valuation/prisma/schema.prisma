// Schema-per-service: зөвхөн `valuation` schema. Өөр schema-ийн хүснэгт рүү FK хориотой — ID-г string-ээр хадгална.
// Эзэмшил: collateral (үнэлгээний тал), collateral_valuation, base_price, haircut_rule. collateralId = origination.collateral.id (string).
// Дүрэм: docs/03-data-model.md (мөнгө Decimal(18,2), харьцаа Decimal(7,4) бутархай, enum-шиг талбар String — утгыг @los/contracts шалгана).
generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client-valuation"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["valuation"]
}

model Outbox {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox")
  @@schema("valuation")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([consumer, eventId])
  @@map("processed_events")
  @@schema("valuation")
}

/// origination.collateral-ийн үнэлгээний талын projection (CLAUDE.md §4): үнэлгээнд хэрэгтэй шинж чанарыг л хадгална.
model Collateral {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  collateralId    String   @map("collateral_id") // origination.collateral.id
  applicationId   String   @map("application_id")
  productId       String?  @map("product_id") // haircut-ийн бүтээгдэхүүн
  assetType       String   @map("asset_type") // AssetType
  descriptionJson Json?    @map("description_json") // plate, make, model, year, mileage | address, area_m2 | head_count…
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by")
  updatedBy       String?  @map("updated_by")

  valuations CollateralValuation[]

  @@unique([orgId, collateralId])
  @@index([applicationId])
  @@map("collateral")
  @@schema("valuation")
}

/// FR-14.3: үнэлгээний бичлэг. Барьцааны үнэлгээ = зах зээлийн үнэ × haircut (FR-14.2); гараар засахад override_reason заавал.
model CollateralValuation {
  id              String    @id @default(uuid())
  orgId           String    @map("org_id")
  collateralRefId String    @map("collateral_ref_id") // valuation.collateral.id
  source          String // ValuationSource
  appraiser       String?
  valuedAt        DateTime  @map("valued_at")
  validUntil      DateTime? @map("valid_until")
  marketValue     Decimal   @map("market_value") @db.Decimal(18, 2)
  haircutRate     Decimal?  @map("haircut_rate") @db.Decimal(7, 4)
  collateralValue Decimal?  @map("collateral_value") @db.Decimal(18, 2)
  methodJson      Json?     @map("method_json")
  reportFileId    String?   @map("report_file_id") // dms.file.id
  overrideReason  String?   @map("override_reason")
  // ── өргөтгөл (docs/03-д байхгүй, DECISIONS.md 2026-10-29 · M6)
  method          String? // ValuationMethod
  suggestedValue  Decimal?  @map("suggested_value") @db.Decimal(18, 2) // тухайн үеийн системийн санал (override-тай харьцуулах)
  haircutSource   String?   @map("haircut_source") // HaircutSource
  externalRequired Boolean  @default(false) @map("external_required")
  licenseNo       String?   @map("license_no")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String?   @map("created_by")
  updatedBy       String?   @map("updated_by")

  collateral Collateral @relation(fields: [collateralRefId], references: [id], onDelete: Cascade)

  @@index([collateralRefId, valuedAt])
  @@map("collateral_valuation")
  @@schema("valuation")
}

/// FR-14.1, FR-14.5: суурь үнийн сан (автомашин: марк/загвар/он; үл хөдлөх: дүүрэг/хороо м²; мал: төрөл/нас). Хувилбартай.
model BasePrice {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  assetType String   @map("asset_type")
  keyJson   Json     @map("key_json")
  unitPrice Decimal  @map("unit_price") @db.Decimal(18, 2)
  validFrom DateTime @map("valid_from") @db.Date
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  @@index([orgId, assetType, validFrom])
  @@map("base_price")
  @@schema("valuation")
}

/// FR-14.2: haircut (бүтээгдэхүүн/хөрөнгийн төрлөөр). product_id = null → бүх бүтээгдэхүүн. 0.70 = 70% (барьцааны үнэлгээ = market × 0.70).
model HaircutRule {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  productId   String?  @map("product_id") // origination.product.id
  assetType   String   @map("asset_type")
  haircutRate Decimal  @map("haircut_rate") @db.Decimal(7, 4)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")

  @@unique([orgId, productId, assetType])
  @@map("haircut_rule")
  @@schema("valuation")
}
