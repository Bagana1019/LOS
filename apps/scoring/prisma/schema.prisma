// Schema-per-service: зөвхөн `scoring` schema. Өөр schema-ийн хүснэгт рүү FK хориотой — ID-г string-ээр хадгална.
// Эзэмшил: calculation, sosco_model, sosco_result, bsa_* (CLAUDE.md §4). application_id/customer_id нь origination-ийн ID (string).
// Дүрэм: docs/03-data-model.md (мөнгө Decimal(18,2), харьцаа Decimal(7,4) бутархай, enum-шиг талбар String — утгыг @los/contracts шалгана).
generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client-scoring"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["scoring"]
}

model Outbox {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox")
  @@schema("scoring")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([consumer, eventId])
  @@map("processed_events")
  @@schema("scoring")
}

// ═══ Тооцоолол (FR-8) ═══

/// Тооцоолол (FR-8). Хүсэлт бүрт олон мөр (түүх); сүүлийнх = computed_at хамгийн шинэ (ижил бол id). Модуль 8: `underwriting` module хариуцна.
model Calculation {
  id                 String    @id @default(uuid())
  orgId              String    @map("org_id")
  applicationId      String    @map("application_id")
  /// Модуль 8: үндсэн зээлдэгч (Sosco Score-ийн субьект). origination-ийн ID — FK биш
  customerId         String?   @map("customer_id")
  computedAt         DateTime  @default(now()) @map("computed_at")
  /// ScoreRequest бүтнээрээ (policy, stress-тэй)
  inputsJson         Json      @map("inputs_json")
  /// Модуль 8: UnderwriteResult бүтнээрээ (CalculationRecord.result)
  resultJson         Json?     @map("result_json")
  /// A/B/C-ийн MethodVerdict
  methodAJson        Json?     @map("method_a_json")
  methodBJson        Json?     @map("method_b_json")
  methodCJson        Json?     @map("method_c_json")
  autoSelectedMethod String?   @map("auto_selected_method") // CalcMethod
  selectedMethod     String?   @map("selected_method")
  /// null + selectedMethod != null => AUTO; хэрэглэгчийн id => MANUAL
  selectedBy         String?   @map("selected_by")
  /// Модуль 8: гараар сонгосны тайлбар (заавал биш, Q-M8-8)
  selectedReason     String?   @map("selected_reason")
  selectedAt         DateTime? @map("selected_at")
  policyCheckJson    Json?     @map("policy_check_json") // dti, dscr, dscrCombined, ltv: value, limit, pass
  stressJson         Json?     @map("stress_json")
  isStale            Boolean   @default(false) @map("is_stale")
  /// Модуль 8: хуучирсан шалтгаан (FR-7.3)
  staleReason        String?   @map("stale_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          String?   @map("created_by")
  updatedBy          String?   @map("updated_by")

  @@index([applicationId, computedAt])
  @@index([orgId, applicationId, computedAt])
  @@map("calculation")
  @@schema("scoring")
}

/// Дотоод Sosco Score-ийн загвар (admin): жин, босго, хувилбар.
model SoscoModel {
  id                  String   @id @default(uuid())
  orgId               String   @map("org_id")
  version             Int
  weightsJson         Json     @map("weights_json")
  gradeThresholdsJson Json     @map("grade_thresholds_json") // A–E
  /// Модуль 8: SoscoCurves (муруй, minCoverage). null (Модуль 0-ийн хуучин мөр) => DEFAULT_SOSCO_CURVES (@los/calc)
  paramsJson          Json?    @map("params_json")
  isActive            Boolean  @default(false) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdBy           String?  @map("created_by")
  updatedBy           String?  @map("updated_by")

  results SoscoResult[]

  @@unique([orgId, version])
  @@map("sosco_model")
  @@schema("scoring")
}

model SoscoResult {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  applicationId String   @map("application_id")
  customerId    String   @map("customer_id")
  modelId       String   @map("model_id")
  score         Int // 0–1000
  grade         String // A–E
  inputsJson    Json?    @map("inputs_json")
  breakdownJson Json?    @map("breakdown_json")
  computedAt    DateTime @default(now()) @map("computed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String?  @map("created_by")
  updatedBy     String?  @map("updated_by")

  model SoscoModel @relation(fields: [modelId], references: [id])

  @@index([applicationId, customerId, computedAt])
  @@map("sosco_result")
  @@schema("scoring")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// BSA (docs/03 «BSA (модуль 10)», docs/02). Нийтлэг баганууд (docs/03 preamble): id, created_at, updated_at, created_by, updated_by,
// org_id, branch_id. Мөнгө numeric(18,2), хувь numeric(7,4). Cross-schema FK хориотой → application_id/customer_id/org_id/branch_id
// нь string id (FK биш). status/direction/channel/dtiRole/matchType/source/format нь String — enum-ийн ЦОРЫН ГАНЦ эх сурвалж
// @los/contracts (хадгалахад repository zod-оор баталгаажуулна). Шифрлэгдсэн (`*_encrypted`) баганыг зөвхөн PiiCipher уншина/бичнэ.
// Нарийвчилсан тайлбар, docs/03-аас ялгаа: prisma/README.md
// ═══════════════════════════════════════════════════════════════════════════════════════════

/// bsa_analysis: LOS хүсэлтийн зээлдэгч бүрийн шинжилгээ. (org, application, customer, version) давтагдахгүй (INT-7).
model BsaAnalysis {
  id                        String    @id @default(uuid())
  applicationId             String    @map("application_id")
  customerId                String    @map("customer_id")
  /// EXTRA: INT-1 — LOS-ын borrower id (BsaSummary.borrowerId)
  borrowerId                String?   @map("borrower_id")
  /// ЗЭЗ — сэжигтэй гүйлгээг шийдвэрлэх (BSA-FR-5.2, M12c)
  officerId                 String?   @map("officer_id")
  /// WEB | LOS | API
  source                    String    @default("LOS")
  /// BsaStatus: DRAFT | ANALYZED
  status                    String    @default("DRAFT")
  version                   Int       @default(1)
  periodFrom                DateTime? @map("period_from") @db.Date
  periodTo                  DateTime? @map("period_to") @db.Date
  periodMonths              Int?      @map("period_months")
  proposedMonthlyPayment    Decimal?  @map("proposed_monthly_payment") @db.Decimal(18, 2)
  costOfGoodsRate           Decimal?  @map("cost_of_goods_rate") @db.Decimal(7, 4)
  /// INT-4 гэрээ (BsaSummary)
  summaryJson               Json?     @map("summary_json")
  analyzedAt                DateTime? @map("analyzed_at")
  pushedToLosAt             DateTime? @map("pushed_to_los_at")
  /// EXTRA: шифрлэгдсэн JSON — овог/нэр, регистр, утас, зарласан дансууд (BSA-FR-1.1)
  customerSnapshotEncrypted String?   @map("customer_snapshot_encrypted")
  /// EXTRA: PiiCipher.hash(регистр) — регистрээр хайх/давхардал шалгах (BSA-FR-1.2); регистр шууд хадгалагдахгүй
  registerNoHash            String?   @map("register_no_hash")
  /// EXTRA: шифрлэгдсэн JSON массив — өөрийн дансууд (BSA-BR-5)
  ownAccountsEncrypted      String?   @map("own_accounts_encrypted")

  orgId     String   @map("org_id")
  branchId  String?  @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  importJobs   BsaImportJob[]
  transactions BsaTransaction[]
  suspicions   BsaSuspicion[]
  events       BsaAnalysisEvent[]

  @@unique([orgId, applicationId, customerId, version], map: "bsa_analysis_version_uq")
  @@index([orgId, branchId, status], map: "bsa_analysis_list_idx")
  @@index([orgId, applicationId], map: "bsa_analysis_application_idx")
  @@index([orgId, registerNoHash], map: "bsa_analysis_register_idx")
  @@index([orgId, createdAt], map: "bsa_analysis_retention_idx")
  @@map("bsa_analysis")
  @@schema("scoring")
}

/// bsa_import_job: хуулгын нэг файлын импорт (BullMQ ажил). (analysis, sha256) давтагдахгүй — ижил файлыг дахин оруулахаас хамгаална.
model BsaImportJob {
  id                  String    @id @default(uuid())
  analysisId          String    @map("analysis_id")
  /// Object store (MinIO)-ийн түлхүүр; нэр/PII агуулахгүй
  fileId              String    @map("file_id")
  /// EXTRA (docs/03-д байхгүй): файлын нэр дансны дугаар/нэр агуулдаг тул шифрлэнэ
  fileNameEncrypted   String    @map("file_name_encrypted")
  mimeType            String    @map("mime_type")
  sizeBytes           Int       @map("size_bytes")
  sha256              String
  bankCode            String?   @map("bank_code")
  /// PDF | IMAGE | CSV | TEXT
  format              String
  accountNoEncrypted  String?   @map("account_no_encrypted")
  ibanEncrypted       String?   @map("iban_encrypted")
  holderNameEncrypted String?   @map("holder_name_encrypted")
  periodFrom          DateTime? @map("period_from") @db.Date
  periodTo            DateTime? @map("period_to") @db.Date
  /// ImportStatus: PENDING | PROCESSING | COMPLETED | FAILED
  status              String    @default("PENDING")
  rowsTotal           Int       @default(0) @map("rows_total")
  rowsDone            Int       @default(0) @map("rows_done")
  /// [{code, message, severity?, page?, line?, seq?}] — PII агуулахгүй (зөвхөн код, мөр/хуудасны дугаар)
  errorsJson          Json?     @map("errors_json")
  warningsJson        Json?     @map("warnings_json")
  parserOk            Boolean?  @map("parser_ok")
  verifierOk          Boolean?  @map("verifier_ok")
  /// null = шалгаагүй (QR байхгүй)
  qrVerified          Boolean?  @map("qr_verified")
  attempts            Int       @default(0)
  startedAt           DateTime? @map("started_at")
  finishedAt          DateTime? @map("finished_at")

  orgId     String   @map("org_id")
  branchId  String?  @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  analysis     BsaAnalysis      @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  transactions BsaTransaction[]

  @@unique([analysisId, sha256], map: "bsa_import_job_file_uq")
  @@index([orgId, branchId, status], map: "bsa_import_job_list_idx")
  @@index([analysisId], map: "bsa_import_job_analysis_idx")
  @@map("bsa_import_job")
  @@schema("scoring")
}

/// bsa_transaction: хуулгын гүйлгээ. Утга, харьцсан данс/нэр шифрлэгдсэн. (analysis, dedupe_key) давтагдахгүй — давхцсан хуулгын мөр нэг л удаа.
model BsaTransaction {
  id                           String   @id @default(uuid())
  analysisId                   String   @map("analysis_id")
  importJobId                  String   @map("import_job_id")
  /// Файл доторх 1-ээс эхэлсэн дараалал
  seq                          Int
  txnDate                      DateTime @map("txn_date") @db.Date
  /// HH:mm | HH:mm:ss
  txnTime                      String?  @map("txn_time")
  /// TxnDirection: INCOME | EXPENSE
  direction                    String
  /// Эерэг дүн
  amount                       Decimal  @db.Decimal(18, 2)
  balanceAfter                 Decimal? @map("balance_after") @db.Decimal(18, 2)
  descriptionEncrypted         String   @map("description_encrypted")
  counterpartyAccountEncrypted String?  @map("counterparty_account_encrypted")
  counterpartyNameEncrypted    String?  @map("counterparty_name_encrypted")
  /// TxnChannel: QPAY | POS | ATM | TRANSFER | OTHER
  channel                      String   @default("OTHER")
  /// null = ангилаагүй (импортын дараа, ангилахаас өмнө)
  categoryCode                 String?  @map("category_code")
  categoryGroup                String?  @map("category_group")
  confidence                   Decimal  @default(0) @db.Decimal(5, 2)
  isOwnTransfer                Boolean  @default(false) @map("is_own_transfer")
  manualOverride               Boolean  @default(false) @map("manual_override")
  overrideBy                   String?  @map("override_by")
  /// Харьцсан дансны blind index (PiiCipher.hash) — дансыг ил хадгалахгүй
  counterpartyAccountHash      String?  @map("counterparty_account_hash")
  /// Хуулга/дансны тодорхойлогч (PiiCipher.hash — дансны дугаар ил хадгалахгүй)
  statementKey                 String   @map("statement_key")
  /// Агуулгын hash (давхцсан хуулгын ижил мөрийг таних) — dedupe-key.ts
  dedupeKey                    String   @map("dedupe_key")

  orgId     String   @map("org_id")
  branchId  String?  @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  analysis  BsaAnalysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  importJob BsaImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([analysisId, dedupeKey], map: "bsa_transaction_dedupe_uq")
  @@index([analysisId, txnDate], map: "bsa_transaction_date_idx")
  @@index([analysisId, categoryCode], map: "bsa_transaction_category_idx")
  @@index([importJobId], map: "bsa_transaction_job_idx")
  @@map("bsa_transaction")
  @@schema("scoring")
}

/// bsa_category: ангилал (admin засна, NFR-6). (org, code) давтагдахгүй.
model BsaCategory {
  id        String  @id @default(uuid())
  code      String
  /// TxnDirection
  direction String
  groupCode String  @map("group_code")
  name      String
  /// Дайчлах хувь 0..1 (зарлагад 1)
  weight    Decimal @db.Decimal(7, 4)
  /// BsaDtiRole: INCOME | DEBT_SERVICE | HOUSEHOLD | BUSINESS_EXPENSE | EXCLUDE | INFO
  dtiRole   String  @map("dti_role")
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  orgId     String   @map("org_id")
  branchId  String?  @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  @@unique([orgId, code], map: "bsa_category_code_uq")
  @@map("bsa_category")
  @@schema("scoring")
}

/// bsa_rule: ангиллын дүрэм. EXTRA unique: seed/хэрэглэгчийн санал давхар үүсгэхгүй (байгалийн түлхүүр). Ижил хэвтэй ДАРАХ дүрэм
/// (өөр ангилал/priority/source) зөвшөөрөгдөнө.
model BsaRule {
  id           String  @id @default(uuid())
  direction    String
  /// BsaRuleMatchType: KEYWORD | COUNTERPARTY | REGEX
  matchType    String  @map("match_type")
  pattern      String
  categoryCode String  @map("category_code")
  /// Их утга түрүүлж шалгагдана
  priority     Int
  /// BsaRuleSource: ADMIN | FEEDBACK
  source       String
  isActive     Boolean @default(true) @map("is_active")

  orgId     String   @map("org_id")
  branchId  String?  @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  @@unique([orgId, direction, matchType, pattern, categoryCode, source], map: "bsa_rule_natural_uq")
  @@index([orgId, direction, priority], map: "bsa_rule_priority_idx")
  @@map("bsa_rule")
  @@schema("scoring")
}

/// bsa_analysis_event (EXTRA хүснэгт): шинжилгээний өөрчлөлтийн түүх — NFR-4 аудит + тойм дэлгэцийн «өөрчлөлтийн түүх».
/// Бичилт нэмэгдэх л (append-only). detail_json PII агуулахгүй.
model BsaAnalysisEvent {
  id         String   @id @default(uuid())
  analysisId String   @map("analysis_id")
  at         DateTime @default(now())
  actorId    String?  @map("actor_id")
  /// Үйлдлийн код (жишээ: IMPORT_COMPLETED, RECLASSIFIED, RECALCULATED, PUSHED_TO_LOS)
  action     String
  detailJson Json?    @map("detail_json")

  orgId     String   @map("org_id")
  branchId  String?  @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  analysis BsaAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, at(sort: Desc)], map: "bsa_analysis_event_history_idx")
  @@map("bsa_analysis_event")
  @@schema("scoring")
}

model BsaSuspicion {
  id             String    @id @default(uuid())
  orgId          String    @map("org_id")
  analysisId     String    @map("analysis_id")
  flag           String // SuspicionFlag
  transactionIds String[]  @map("transaction_ids")
  confidence     Decimal?  @db.Decimal(5, 2) // 0–100
  status         String    @default("PENDING") // ReviewStatus
  action         String? // ReviewAction
  comment        String?
  resolvedBy     String?   @map("resolved_by")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")

  analysis BsaAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, status])
  @@map("bsa_suspicion")
  @@schema("scoring")
}
