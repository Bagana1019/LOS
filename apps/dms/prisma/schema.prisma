// Schema-per-service: зөвхөн `dms` schema. Өөр schema-ийн хүснэгт рүү FK хориотой — ID-г string-ээр хадгална.
// Эзэмшил: file, document, contract_template, document_checklist, retention_policy. application_id нь origination-ийн ID (string).
// Дүрэм: docs/03-data-model.md (мөнгө Decimal(18,2), харьцаа Decimal(7,4) бутархай, enum-шиг талбар String — утгыг @los/contracts шалгана).
generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client-dms"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["dms"]
}

model Outbox {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox")
  @@schema("dms")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([consumer, eventId])
  @@map("processed_events")
  @@schema("dms")
}

/// MinIO-д хадгалагдсан файлын метадата. storage_key нь bucket доторх зам; агуулга шифрлэгдсэн bucket-д.
model File {
  id             String    @id @default(uuid())
  orgId          String    @map("org_id")
  bucket         String
  storageKey     String    @map("storage_key")
  name           String
  mime           String
  size           Int
  sha256         String
  uploadedBy     String?   @map("uploaded_by")
  retentionUntil DateTime? @map("retention_until")
  purgedAt       DateTime? @map("purged_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")

  documents Document[]
  templates ContractTemplate[]

  @@unique([bucket, storageKey])
  @@index([orgId, sha256])
  @@index([retentionUntil])
  @@map("file")
  @@schema("dms")
}

/// FR-9: хүсэлтэд хавсаргасан баримт (төрөл, холбогдох зүйл, checklist key).
model Document {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  applicationId String   @map("application_id")
  type          String
  relatedEntity String   @map("related_entity") // DocumentRelatedEntity
  relatedId     String?  @map("related_id")
  note          String?
  fileId        String   @map("file_id")
  checklistKey  String?  @map("checklist_key")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String?  @map("created_by")
  updatedBy     String?  @map("updated_by")

  file File @relation(fields: [fileId], references: [id])

  @@index([applicationId, checklistKey])
  @@map("document")
  @@schema("dms")
}

/// FR-11: гэрээ, ЭТХ, албан бичгийн загвар (docx placeholder). product_id = origination.product.id.
model ContractTemplate {
  id               String   @id @default(uuid())
  orgId            String   @map("org_id")
  productId        String?  @map("product_id")
  type             String // ContractTemplateType
  name             String
  docxFileId       String   @map("docx_file_id")
  placeholdersJson Json?    @map("placeholders_json")
  version          Int      @default(1)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by")
  updatedBy        String?  @map("updated_by")

  docx File @relation(fields: [docxFileId], references: [id])

  @@index([orgId, productId, type, isActive])
  @@map("contract_template")
  @@schema("dms")
}

/// FR-9.2, FR-6.7: бүтээгдэхүүн/хөрөнгийн төрлөөр заавал баримтын checklist.
model DocumentChecklist {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  productId     String?  @map("product_id")
  key           String
  name          String
  relatedEntity String   @map("related_entity") // DocumentRelatedEntity
  assetType     String?  @map("asset_type") // collateral checklist-д
  isRequired    Boolean  @default(true) @map("is_required")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String?  @map("created_by")
  updatedBy     String?  @map("updated_by")

  @@unique([orgId, productId, key])
  @@map("document_checklist")
  @@schema("dms")
}

/// Хадгалах хугацаа (BSA хуулга 3 жил — BSA-BR-8). retention job үүгээр file.retention_until тооцно.
model RetentionPolicy {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  entityType     String   @map("entity_type") // BSA_STATEMENT | APPLICATION_DOCUMENT | CONTRACT | DRAFT_ATTACHMENT
  retentionYears Int      @map("retention_years")
  autoDelete     Boolean  @default(false) @map("auto_delete")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")

  @@unique([orgId, entityType])
  @@map("retention_policy")
  @@schema("dms")
}

// FR-11.4 Цахим гарын үсгийн хүсэлт. Багана бүр SigningRequestRecord-той (modules/esign/ports/signing.store.ts) 1:1.
// Enum-ууд (@los/contracts) Prisma enum биш String — status/provider/failure_reason-ийн CHECK constraint болон
// "нэг гэрээнд ЗӨВХӨН нэг идэвхтэй хүсэлт" PARTIAL UNIQUE INDEX (signing_request_active_contract_key:
// UNIQUE (contract_id) WHERE status IN ('PENDING','IN_PROGRESS','FINALIZING')) миграцид гараар нэмсэн — Prisma эдгээрийг schema-д
// илэрхийлж чадахгүй (`prisma migrate diff` тэдгээрийг drift гэж үзэхгүй). Шинэ миграци үүсгэхдээ CHECK/partial index-ийг устгаагүй эсэхийг шалга.
// org_id, application_id, contract_id, *_file_id, signer_customer_id — бусад сервис/модулийн id (string, FK-гүй).
model SigningRequest {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                   String    @map("org_id")
  applicationId           String    @map("application_id")
  contractId              String    @map("contract_id")
  contractNo              String    @map("contract_no")
  /// SigningStatus
  status                  String
  /// ESignProvider; зээлдэгч сонгох хүртэл null
  provider                String?
  providerRef             String?   @map("provider_ref")
  challengeCode           String?   @map("challenge_code")
  deepLink                String?   @map("deep_link")
  sessionExpiresAt        DateTime? @map("session_expires_at") @db.Timestamptz(3)
  sourceFileId            String    @map("source_file_id")
  signedFileId            String?   @map("signed_file_id")
  signatureFileId         String?   @map("signature_file_id")
  originalSha256          String    @map("original_sha256")
  signedSha256            String?   @map("signed_sha256")
  signerCustomerId        String    @map("signer_customer_id")
  signerName              String    @map("signer_name")
  /// SensitiveFieldCipher-ээр шифрлэгдсэн (CLAUDE.md §6.5)
  signerRegisterEncrypted String    @map("signer_register_encrypted")
  signerPhoneEncrypted    String    @map("signer_phone_encrypted")
  signerRegisterMasked    String    @map("signer_register_masked")
  signerPhoneMasked       String    @map("signer_phone_masked")
  /// SHA-256(hex) of the one-time link token; токен өөрөө хадгалагдахгүй
  tokenHash               String    @unique @map("token_hash")
  linkExpiresAt           DateTime  @map("link_expires_at") @db.Timestamptz(3)
  /// 12 тэмдэгт, SIGNED үед тавигдана
  verificationCode        String?   @unique @map("verification_code")
  documentViewedAt        DateTime? @map("document_viewed_at") @db.Timestamptz(3)
  consentAt               DateTime? @map("consent_at") @db.Timestamptz(3)
  attempts                Int       @default(0)
  /// SignerCertificate (огноонууд ISO string)
  certificate             Json?
  providerTxnId           String?   @map("provider_txn_id")
  providerMock            Boolean   @default(false) @map("provider_mock")
  /// SigningFailureReason
  failureReason           String?   @map("failure_reason")
  failureDetail           String?   @map("failure_detail")
  correlationId           String    @map("correlation_id")
  createdBy               String?   @map("created_by")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  signedAt                DateTime? @map("signed_at") @db.Timestamptz(3)

  events SigningEvent[]

  @@unique([provider, providerRef])
  @@index([applicationId])
  @@index([contractId, status])
  @@map("signing_request")
  @@schema("dms")
}

// FR-11.4 Гарын үсгийн хүсэлтийн аудит (SigningAuditEntry). PII-гүй: ip, user_agent, detail-д регистр/утас бичихгүй.
model SigningEvent {
  /// Оруулсан дарааллыг хадгална (listAudit: at, id)
  id               BigInt         @id @default(autoincrement())
  signingRequestId String         @map("signing_request_id") @db.Uuid
  /// SigningAuditType
  type             String
  /// 'BORROWER' | 'SYSTEM' | 'PROVIDER' | хэрэглэгчийн id
  actor            String
  at               DateTime       @db.Timestamptz(3)
  ip               String?
  userAgent        String?        @map("user_agent")
  detail           Json           @default("{}")
  signingRequest   SigningRequest @relation(fields: [signingRequestId], references: [id])

  @@index([signingRequestId, at])
  @@map("signing_event")
  @@schema("dms")
}
